# Python önbellek ve derleme dosyaları
__pycache__/
*.py[cod]
*$py.class

# PyInstaller ve Inno Setup büyük derleme çıktıları (GitHub 100MB sınırına takılmaması için)
build/
dist/
installer_cikti/

# Harici büyük ikili (binary) araçlar (Releases paketine dahildir)
ffmpeg.exe
runtime/

# Stüdyo çalışma zamanı geçici önbellekleri ve kişisel veritabanı/ayarlar
.studyo_ref_cache*/
config/*.bak
config/user_settings.json
config/studyo_checkpoints.db
config/studyo_checkpoints.db-wal
config/studyo_checkpoints.db-shm

# Üretilen sesler ve kullanıcının sonradan eklediği özel sesler
cikti_sesler/
referans_sesler_ozel/

# Sanal ortam ve IDE klasörleri
.venv/
venv/
env/
.vscode/
.idea/